# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (PostgreSQL / Supabase / Neon / Railway)
DATABASE_URL="postgresql://postgres:password@localhost:5432/marvel_auction?schema=public"

# Optional AI Battle Judge (Gemini API)
GEMINI_API_KEY=""
AI_JUDGE_API_KEY=""

# Analytics Debug Mode (set to "true" to log all game analytics events to console)
# Also settable at runtime via localStorage: localStorage.setItem('analytics_debug', 'true')
VITE_ANALYTICS_DEBUG=""
